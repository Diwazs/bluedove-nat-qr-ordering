{
 "name": "Blue Dove - QR Order, Ready Board, Daily Summary",
 "nodes": [
  {
   "parameters": {
    "httpMethod": "POST",
    "path": "bluedove-order",
    "responseMode": "responseNode",
    "options": {
     "allowedOrigins": "*"
    }
   },
   "name": "Order Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "webhookId": "bluedove-order"
  },
  {
   "parameters": {
    "jsCode": "// ===== EDIT THIS: your n8n base URL (no trailing slash) =====\nconst BASE = 'https://YOUR-N8N-URL';\nconst body = $input.first().json.body || {};\nconst items = body.items || [];               // [{id,name,qty,price}]\nconst sd = $getWorkflowStaticData('global');\nsd.counter = ((sd.counter || 0) % 99) + 1;    // token 1..99, then wraps\nconst token = sd.counter;\nconst now = new Date();\nconst hourIST = Number(now.toLocaleString('en-GB',{timeZone:'Asia/Kolkata',hour:'2-digit',hour12:false}));\nconst total = items.reduce((s,i)=>s+i.qty*i.price,0);\nconst order_id = 'BD' + now.getTime().toString(36).toUpperCase();\nconst itemsText = items.map(i=>`${i.qty} x ${i.name}`).join(', ');\nreturn [{json:{\n  order_id, token, placed_at: now.toISOString(), placed_hour_ist: hourIST,\n  customer: body.customer || 'Guest', items: itemsText, total,\n  status: 'received', ready_at: '',\n  ready_link: `${BASE}/webhook/bluedove-ready?order_id=${order_id}&token=${token}`\n}}];"
   },
   "name": "Build Order",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {
    "operation": "append",
    "documentId": {
     "__rl": true,
     "mode": "id",
     "value": "YOUR_GOOGLE_SHEET_ID"
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Orders"
    },
    "columns": {
     "mappingMode": "defineBelow",
     "value": {
      "order_id": "={{ $json.order_id }}",
      "token": "={{ $json.token }}",
      "placed_at": "={{ $json.placed_at }}",
      "placed_hour_ist": "={{ $json.placed_hour_ist }}",
      "customer": "={{ $json.customer }}",
      "items": "={{ $json.items }}",
      "total": "={{ $json.total }}",
      "status": "={{ $json.status }}",
      "ready_at": "={{ $json.ready_at }}"
     },
     "matchingColumns": [],
     "schema": []
    },
    "options": {}
   },
   "name": "Log Order",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    440,
    0
   ],
   "credentials": {
    "googleSheetsOAuth2Api": {
     "id": "",
     "name": "Google Sheets account"
    }
   }
  },
  {
   "parameters": {
    "chatId": "YOUR_STAFF_CHAT_ID",
    "text": "=New order #{{ $('Build Order').item.json.token }}\n{{ $('Build Order').item.json.items }}\nTotal: Rs {{ $('Build Order').item.json.total }}\n\nTap when ready: {{ $('Build Order').item.json.ready_link }}",
    "additionalFields": {
     "appendAttribution": false
    }
   },
