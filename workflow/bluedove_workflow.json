   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    520
   ]
  },
  {
   "parameters": {
    "operation": "read",
    "documentId": {
     "__rl": true,
     "mode": "id",
     "value": "YOUR_GOOGLE_SHEET_ID"
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Orders"
    },
    "options": {}
   },
   "name": "Read Orders",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    220,
    520
   ],
   "credentials": {
    "googleSheetsOAuth2Api": {
     "id": "",
     "name": "Google Sheets account"
    }
   }
