  {
   "parameters": {
    "jsCode": "// Average wait (minutes) by hour, today's orders only (IST)\nconst today = new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Kolkata'});\nconst rows = $input.all().map(i=>i.json).filter(r=>{\n  if(!r.placed_at) return false;\n  return new Date(r.placed_at).toLocaleDateString('en-CA',{timeZone:'Asia/Kolkata'})===today;\n});\nconst done = rows.filter(r=>r.ready_at);\nconst byHour = {};\ndone.forEach(r=>{\n  const mins=(new Date(r.ready_at)-new Date(r.placed_at))/60000;\n  const h=r.placed_hour_ist; (byHour[h]=byHour[h]||[]).push(mins);\n});\nconst lines = Object.keys(byHour).sort((a,b)=>a-b).map(h=>{\n  const a=byHour[h]; const avg=a.reduce((x,y)=>x+y,0)/a.length;\n  return `${h}:00 - avg ${avg.toFixed(1)} min, max ${Math.max(...a).toFixed(1)} min (${a.length} orders)`;\n});\nconst text = `Blue Dove daily summary (${today})\\nOrders: ${rows.length}, completed: ${done.length}\\n` + (lines.join('\\n') || 'No completed orders yet.');\nreturn [{json:{text}}];"
   },
   "name": "Compute Wait Stats",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    520
   ]
  },
  {
   "parameters": {
    "chatId": "YOUR_STAFF_CHAT_ID",
    "text": "={{ $json.text }}",
    "additionalFields": {
     "appendAttribution": false
    }
   },
   "name": "Send Summary",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    660,
    520
   ],
   "credentials": {
    "telegramApi": {
     "id": "",
     "name": "Telegram account"
    }
   }
  }
 ],
